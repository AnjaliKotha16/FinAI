# FinAI Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/finai_db

# Client CORS Configuration
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Vite Configuration (client/.env)
VITE_API_BASE_URL=http://localhost:5000/api
